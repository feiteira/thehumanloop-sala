<?xml version="1.0" encoding="utf-8"?>
<!-- "Sala (example)" in the Start menu, next to Sala: the same program started in example mode,
     which opens a fictional practice that resets at every start. One shortcut per installer language. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ExampleShortcutPt" Guid="6B7E2F0C-3C1A-4D55-9A0B-51C1E4A2B701">
        <Condition><![CDATA[ProductLanguage = 2070]]></Condition>
        <Shortcut Id="ExampleShortcutPt" Name="Sala (exemplo)" Target="[!Path]" Arguments="--example" Icon="ProductIcon" WorkingDirectory="INSTALLDIR" />
        <RegistryValue Root="HKCU" Key="Software\[Manufacturer]\[ProductName]" Name="Example Shortcut pt" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="ExampleShortcutEs" Guid="6B7E2F0C-3C1A-4D55-9A0B-51C1E4A2B702">
        <Condition><![CDATA[ProductLanguage = 3082 OR ProductLanguage = 1034]]></Condition>
        <Shortcut Id="ExampleShortcutEs" Name="Sala (ejemplo)" Target="[!Path]" Arguments="--example" Icon="ProductIcon" WorkingDirectory="INSTALLDIR" />
        <RegistryValue Root="HKCU" Key="Software\[Manufacturer]\[ProductName]" Name="Example Shortcut es" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="ExampleShortcutEn" Guid="6B7E2F0C-3C1A-4D55-9A0B-51C1E4A2B703">
        <Condition><![CDATA[ProductLanguage <> 2070 AND ProductLanguage <> 3082 AND ProductLanguage <> 1034]]></Condition>
        <Shortcut Id="ExampleShortcutEn" Name="Sala (example)" Target="[!Path]" Arguments="--example" Icon="ProductIcon" WorkingDirectory="INSTALLDIR" />
        <RegistryValue Root="HKCU" Key="Software\[Manufacturer]\[ProductName]" Name="Example Shortcut en" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <ComponentGroup Id="ExampleShortcuts">
      <ComponentRef Id="ExampleShortcutPt" />
      <ComponentRef Id="ExampleShortcutEs" />
      <ComponentRef Id="ExampleShortcutEn" />
    </ComponentGroup>
  </Fragment>
</Wix>
