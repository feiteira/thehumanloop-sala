{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Sala's main window: core events, the system file dialogs, HTTPS to the file on Sala's website that names the latest version (only when the therapist checks for updates), and opening Sala's download page in the browser.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://sala.thehumanloop.eu/downloads/manifest.json"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://sala.thehumanloop.eu/*"
        }
      ]
    }
  ]
}
